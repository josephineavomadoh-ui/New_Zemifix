datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/platform-client"
}

enum TenantStatus {
  REGISTERED
  PROVISIONING
  ACTIVE
  SUSPENDED
  PROVISIONING_FAILED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum DeploymentStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
  DECOMMISSIONED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model PlatformUser {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String             @db.VarChar(150)
  email         String             @unique @db.VarChar(255)
  passwordHash  String             @db.Text
  isActive      Boolean            @default(true)
  mfaSecret     String?            @db.Text
  mfaEnabled    Boolean            @default(false)
  roleId        String             @db.Uuid
  role          PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions      PlatformSession[]
  auditLogs     PlatformAuditLog[]
  createdAt     DateTime           @default(now()) @db.Timestamptz
  updatedAt     DateTime           @updatedAt @db.Timestamptz

  @@index([email])
  @@index([roleId])
  @@map("platform_users")
}

model PlatformRole {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String                   @unique @db.VarChar(50)
  name        String                   @db.VarChar(100)
  description String?                  @db.Text
  users       PlatformUser[]
  permissions PlatformRolePermission[]
  createdAt   DateTime                 @default(now()) @db.Timestamptz
  updatedAt   DateTime                 @updatedAt @db.Timestamptz

  @@map("platform_roles")
}

model PlatformPermission {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String                   @db.VarChar(50)
  action      String                   @db.VarChar(50)
  description String?                  @db.Text
  roles       PlatformRolePermission[]
  createdAt   DateTime                 @default(now()) @db.Timestamptz

  @@unique([resource, action])
  @@map("platform_permissions")
}

model PlatformRolePermission {
  roleId       String             @db.Uuid
  role         PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String             @db.Uuid
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("platform_role_permissions")
}

model Tenant {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String             @unique @db.VarChar(100)
  name         String             @db.VarChar(200)
  status       TenantStatus       @default(REGISTERED)
  deployment   TenantDeployment?
  subscription Subscription?
  auditLogs    PlatformAuditLog[]
  createdAt    DateTime           @default(now()) @db.Timestamptz
  updatedAt    DateTime           @updatedAt @db.Timestamptz

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model TenantDeployment {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String           @unique @db.Uuid
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dbName            String           @db.VarChar(150)
  secretArn         String?          @db.Text
  dbUrlEncrypted    String?          @db.Text
  storageBucket     String           @db.VarChar(255)
  customDomain      String?          @unique @db.VarChar(255)
  status            DeploymentStatus @default(PENDING)
  createdAt         DateTime         @default(now()) @db.Timestamptz
  updatedAt         DateTime         @updatedAt @db.Timestamptz

  @@index([tenantId])
  @@map("tenant_deployments")
}

model SubscriptionPlan {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @db.VarChar(100)
  code         String         @unique @db.VarChar(50)
  maxUsers     Int            @default(10) @db.Integer
  priceMonthly Decimal        @db.Decimal(12, 2)
  currency     String         @default("GHS") @db.Char(3)
  isActive     Boolean        @default(true)
  subscriptions Subscription[]
  createdAt    DateTime       @default(now()) @db.Timestamptz
  updatedAt    DateTime       @updatedAt @db.Timestamptz

  @@map("subscription_plans")
}

model Subscription {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @unique @db.Uuid
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planId            String             @db.Uuid
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status            SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime          @db.Timestamptz
  currentPeriodEnd   DateTime          @db.Timestamptz
  createdAt         DateTime           @default(now()) @db.Timestamptz
  updatedAt         DateTime           @updatedAt @db.Timestamptz

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model PlatformAuditLog {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId   String?       @db.Uuid
  platformUser     PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)
  tenantId         String?       @db.Uuid
  tenant           Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action           String        @db.VarChar(100)
  targetResource   String        @db.VarChar(100)
  targetResourceId String?       @db.Uuid
  outcome          AuditOutcome  @default(SUCCESS)
  clientIp         String        @db.VarChar(45)
  payload          Json?
  previousChecksum String?       @db.VarChar(64)
  checksum         String        @db.VarChar(64)
  createdAt        DateTime      @default(now()) @db.Timestamptz

  @@index([platformUserId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

model PlatformSession {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String       @db.Uuid
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  jti            String       @unique @db.VarChar(100)
  expiresAt      DateTime     @db.Timestamptz
  revokedAt      DateTime?    @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz

  @@index([platformUserId])
  @@index([jti])
  @@map("platform_sessions")
}
