# ZemiFix CMMS Environment Configuration Example
# Primary Operating Timezone: Africa/Accra

NODE_ENV=production
APP_ENV=production
APP_DATABASE_URL=postgresql://zemifix_app_user:password@localhost:5432/zemifix_prod?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/zemifix_prod?schema=public
# Canonical base64 for 32 random bytes; provision the matching value in the restricted DB key table.
# APP_CONTEXT_HMAC_SECRET=
# Provisioning-only values. Never expose the migration URL to application processes.
# SECURITY_CONTEXT_MIGRATION_ROLE=
# SECURITY_CONTEXT_MIGRATION_URL=
PLATFORM_DATABASE_URL=postgresql://user:password@localhost:5432/zemifix_platform_prod?schema=public
SESSION_SECRET=your-super-secure-session-secret-at-least-32-chars-long
PLATFORM_SESSION_SECRET=your-super-secure-platform-session-secret-at-least-32-chars-long
PLATFORM_ENCRYPTION_KEY=your-super-secure-platform-encryption-key-at-least-32-chars-long
OTP_SECRET=your-super-secure-otp-secret-at-least-32-chars-long
PORTAL_SESSION_SECRET=your-super-secure-portal-secret-at-least-32-chars-long
APPROVAL_SECRET=your-super-secure-approval-secret-at-least-32-chars-long
WORKER_SECRET=your-super-secure-worker-secret-at-least-32-chars-long
NEXT_PUBLIC_APP_URL=https://cmms.zemifix.local
# Comma-separated additional explicit development origins (e.g. temporary ngrok tunnels)
ADDITIONAL_TRUSTED_ORIGINS=https://underfoot-monument-morphing.ngrok-free.dev
RESEND_API_KEY=re_your_resend_api_key_here
OTP_FROM_EMAIL=no-reply@zemifix.local
TZ=Africa/Accra
